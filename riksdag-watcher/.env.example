# Seconds between polls (default 5 minutes)
POLL_INTERVAL=300

# How many speeches to fetch per poll
PAGE_SIZE=50

# Comma-separated list of HTTP endpoints to POST when a video is ready.
# Each receives a JSON body with anforande_id, talare, datum, local_video, etc.
WEBHOOK_URLS=http://asr-service:8080/ingest

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
